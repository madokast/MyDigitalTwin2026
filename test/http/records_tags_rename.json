    "rename_not_found":{
        "api": "/api/records/-1/tags/{unique:1}",
        "method": "PATCH",
        "headers": {"Authorization": "{token}"},
        "data": {"new_tag": "{unique:2}"},
        "expected": {"ok":false,"status":404,"message":"record -1 not found"}
    },
    "rename_not_integer":{
        "api": "/api/records/abc/tags/{unique:1}",
        "method": "PATCH",
        "headers": {"Authorization": "{token}"},
        "data": {"new_tag": "{unique:2}"},
        "expected": {"ok":false,"status":400,"message":"parameter record_id in path PATCH /api/records/{record_id}/tags/{tag} expected an integer, but got: 'abc'"}
    },
    "rename_whitespace_old_tag":{
        "before": [{
            "api": "/api/records",
