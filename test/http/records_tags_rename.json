        "api": "/api/records/{extracted:record.id}/tags/ ",
        "method": "PATCH",
        "headers": {"Authorization": "{token}"},
        "data": {"new_tag": "{unique:5}"},
        "expected": {"ok":false,"status":400,"message":"tag cannot be empty or contain only whitespace"}
    },
