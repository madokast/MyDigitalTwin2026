    "rename_unknown_member":{
        "api": "/api/records/1/tags/{unique:1}",
        "method": "PATCH",
        "headers": {"Authorization": "{token}"},
        "data": {"new_tag": "{unique:2}", "extra": 1},
        "expected": {"ok":false,"status":400,"message":"{regex:failed to unmarshal request body: json: (cannot|unable to) unmarshal JSON string into Go tags\\.RenameTagRequest: unknown object member name \"extra\"}"}
    },
