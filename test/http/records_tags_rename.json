{
    "rename_new":{
        "before": [{
            "api": "/api/records",
            "method": "POST",
            "headers": {"Authorization": "{token}"},
            "data": {"raw_content": "{unique:1}","objective_context": "{unique:2}","ai_analysis": "{unique:3}",
                "tags": ["{unique:4}"]},
            "extractions": ["record.id"]
        }],
        "api": "/api/records/{extracted:record.id}/tags/{unique:4}",
        "method": "PATCH",
        "headers": {"Authorization": "{token}"},
        "data": {"new_tag": "{unique:5}"},
        "expected": {"ok":true,"status":200,"renamed":true,"changed":true,"tags":["{unique:5}"]}
    },
    "rename_again_idempotent":{
        "before": [
            {
                "api": "/api/records",
                "method": "POST",
                "headers": {"Authorization": "{token}"},
                "data": {"raw_content": "{unique:1}","objective_context": "{unique:2}","ai_analysis": "{unique:3}",
                    "tags": ["{unique:4}"]},
                "extractions": ["record.id"]
            },
            {
                "api": "/api/records/{extracted:record.id}/tags/{unique:4}",
                "method": "PATCH",
                "headers": {"Authorization": "{token}"},
                "data": {"new_tag": "{unique:5}"}
            }
        ],
        "api": "/api/records/{extracted:record.id}/tags/{unique:4}",
        "method": "PATCH",
        "headers": {"Authorization": "{token}"},
        "data": {"new_tag": "{unique:6}"},
        "expected": {"ok":true,"status":200,"renamed":false,"changed":false,"tags":["{unique:5}"]}
    },
    "rename_one_of_many":{
        "before": [{
            "api": "/api/records",
            "method": "POST",
            "headers": {"Authorization": "{token}"},
            "data": {"raw_content": "{unique:1}","objective_context": "{unique:2}","ai_analysis": "{unique:3}",
                "tags": ["{unique:4}", "{unique:5}", "{unique:6}"]},
            "extractions": ["record.id"]
        }],
        "api": "/api/records/{extracted:record.id}/tags/{unique:5}",
        "method": "PATCH",
        "headers": {"Authorization": "{token}"},
        "data": {"new_tag": "{unique:7}"},
        "expected": {"ok":true,"status":200,"renamed":true,"changed":true,"tags":["{unique:4}", "{unique:7}", "{unique:6}"]}
    },
    "rename_new_tag_same_as_old":{
