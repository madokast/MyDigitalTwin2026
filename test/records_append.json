{
    "empty_record" : {
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {},
        "expected": {"ok":false,"status":400,"message":"raw content cannot be empty"}
    },
    "bad_record" : {
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": "{empty}",
        "expected": {"ok":false,"status":400,"message":"failed to unmarshal request body: jsontext: unexpected EOF"}
    },
    "only_raw_content" : {
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {
            "raw_content": "This is a test record."
        },
        "expected": {"ok":false,"status":400,"message":"objective context cannot be empty"}
    },
    "only_raw_content_and_objective_context" : {
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {
            "raw_content": "This is a test record.",
            "objective_context": "Test Objective"
        },
        "expected": {"ok":false,"status":400,"message":"AI analysis cannot be empty"}
    },
    "no_tags":{
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {
            "raw_content": "This is a test record for no tags.",
            "objective_context": "Test Objective",
            "ai_analysis": "Test AI Analysis"
        },
        "expected": {"ok":true,"status":201,"record":{"id":"{integer}","created_at":"{time}",
            "raw_content":"This is a test record for no tags.","objective_context":"Test Objective",
            "ai_analysis":"Test AI Analysis","tags":[]}}
    },
    "null_tags":{
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {
            "raw_content": "This is a test record for null tags.",
            "objective_context": "Test Objective",
            "ai_analysis": "Test AI Analysis",
            "tags": null
        },
        "expected": {"ok":true,"status":201,"record":{"id":"{integer}","created_at":"{time}",
            "raw_content":"This is a test record for null tags.","objective_context":"Test Objective",
            "ai_analysis":"Test AI Analysis","tags":[]}}
    },
    "empty_tags":{
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {
            "raw_content": "This is a test record for empty tags.",
            "objective_context": "Test Objective",
            "ai_analysis": "Test AI Analysis",
            "tags": []
        },
        "expected": {"ok":true,"status":201,"record":{"id":"{integer}","created_at":"{time}",
            "raw_content":"This is a test record for empty tags.","objective_context":"Test Objective",
            "ai_analysis":"Test AI Analysis","tags":[]}}
    },
    "one_tag":{
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {
            "raw_content": "This is a test record for one tag.",
            "objective_context": "Test Objective",
            "ai_analysis": "Test AI Analysis",
            "tags": ["apple"]
        },
        "expected": {"ok":true,"status":201,"record":{"id":"{integer}","created_at":"{time}",
            "raw_content":"This is a test record for one tag.","objective_context":"Test Objective",
            "ai_analysis":"Test AI Analysis","tags":["apple"]}}
    },
    "two_tags":{
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {
            "raw_content": "This is a test record for two tags.",
            "objective_context": "Test Objective",
            "ai_analysis": "Test AI Analysis",
            "tags": ["apple", "学习"]
        },
        "expected": {"ok":true,"status":201,"record":{"id":"{integer}","created_at":"{time}",
            "raw_content":"This is a test record for two tags.","objective_context":"Test Objective",
            "ai_analysis":"Test AI Analysis","tags":["apple", "学习"]}}
    },
    "empty_string_tags":{
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {
            "raw_content": "This is a test record.",
            "objective_context": "Test Objective",
            "ai_analysis": "Test AI Analysis",
            "tags": [" "]
        },
        "expected": {"ok":false,"status":400,"message":"tags cannot contain empty strings"}
    },
    "duplicate_tags":{
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {
            "raw_content": "This is a test record.",
            "objective_context": "Test Objective",
            "ai_analysis": "Test AI Analysis",
            "tags": ["a", "b", "a"]
        },
        "expected": {"ok":false,"status":400,"message":"duplicate tags are not allowed"}
    },
    "chinese":{
        "api": "/api/records",
        "method": "POST",
        "headers": {"Authorization": "{token}"},
        "data": {
            "raw_content": "mdk 说话的原始内容",
            "objective_context": "这个原始内容的上下文信息",
            "ai_analysis": "AI 对 mdk 所说话的理解和分析",
            "tags": ["涉及的 tag", "学习", "健身", "阅读", "工作"]
        },
        "expected": {"ok":true,"status":201,"record":{"id":"{integer}","created_at":"{time}",
            "raw_content":"mdk 说话的原始内容","objective_context":"这个原始内容的上下文信息",
            "ai_analysis":"AI 对 mdk 所说话的理解和分析","tags":["涉及的 tag", "学习", "健身", "阅读", "工作"]}}
    }
}
