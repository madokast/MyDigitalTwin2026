{
    "discover": {
        "api": "/mcp",
        "method": "POST",
        "headers": {
            "Authorization": "{token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "Mcp-Protocol-Version": "2026-07-28",
            "Mcp-Method": "server/discover"
        },
        "data": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "server/discover",
            "params": {
                "_meta": {
                    "io.modelcontextprotocol/protocolVersion": "2026-07-28",
                    "io.modelcontextprotocol/clientCapabilities": {},
                    "io.modelcontextprotocol/clientInfo": {
                        "name": "test-client",
                        "version": "1.0.0"
                    }
                }
            }
        },
        "expected": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
                "resultType": "complete",
                "_meta": {
                    "io.modelcontextprotocol/serverInfo": {
                        "name": "MyDigitalTwin2026",
                        "title": "mdk's personal digital twin",
                        "description": "{existed}",
                        "version": "0.0.1"
                    }
                },
                "supportedVersions": [
                    "2026-07-28",
                    "2025-11-25",
                    "2025-06-18",
                    "2025-03-26",
                    "2024-11-05"
                ],
                "capabilities": {
                    "tools": {
                        "listChanged": true
                    }
                },
                "instructions": "{existed}"
            }
        }
    },
    "tools_list": {
        "api": "/mcp",
        "method": "POST",
        "headers": {
            "Authorization": "{token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "Mcp-Protocol-Version": "2026-07-28",
            "Mcp-Method": "tools/list"
        },
        "data": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/list",
            "params": {
                "_meta": {
                    "io.modelcontextprotocol/protocolVersion": "2026-07-28",
                    "io.modelcontextprotocol/clientCapabilities": {},
                    "io.modelcontextprotocol/clientInfo": {
                        "name": "test-client",
                        "version": "1.0.0"
                    }
                }
            }
        },
        "expected": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
                "resultType": "complete",
                "_meta": {
                    "io.modelcontextprotocol/serverInfo": {
                        "name": "MyDigitalTwin2026",
                        "title": "mdk's personal digital twin",
                        "description": "{existed}",
                        "version": "0.0.1"
                    }
                },
                "tools": [
                    {
                        "name": "probe_health",
                        "description": "Probe whether the service is up. Returns ok, the HTTP status, and the current server time (milliseconds, +08:00). Do not use this to query history or write records.",
                        "inputSchema": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "probe_postgresql",
                        "description": "Probe whether PostgreSQL is reachable. Opens a fresh connection, runs SELECT NOW()::text, and returns connection/query latency in milliseconds plus the database clock. Do not use this to query records or write data.",
                        "inputSchema": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "probe_qqbot",
                        "description": "Probe whether the QQ bot can send a message. Optional message: omit to send the default probe text; an empty or whitespace-only string is rejected. Do not use this to query records or write data.",
                        "inputSchema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": [
                                        "null",
                                        "string"
                                    ],
                                    "description": "Optional probe message. Omit to send the default text. An empty or whitespace-only string is rejected."
                                }
                            },
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "records_get",
                        "description": "Fetch one of mdk's records by id. Returns the raw utterance, objective context, AI analysis, tags, and creation time. record_id is required. Do not use this to create records, list history, or as a health check.",
                        "inputSchema": {
                            "type": "object",
                            "properties": {
                                "record_id": {
                                    "type": "integer",
                                    "description": "Record ID assigned by the server when the record was created"
                                }
                            },
                            "required": ["record_id"],
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "records_post",
                        "description": "Create a record of mdk's utterance with objective context, AI analysis, and optional tags. raw_content, objective_context, and ai_analysis are required and must not be blank. tags are optional; omit or pass [] for none. Do not use this as a health check or to query history.",
                        "inputSchema": {
                            "type": "object",
                            "properties": {
                                "raw_content": {
                                    "type": "string",
                                    "description": "mdk's raw utterance; required, must not be blank"
                                },
                                "objective_context": {
                                    "type": "string",
                                    "description": "Objective conversation context; required, must not be blank"
                                },
                                "ai_analysis": {
                                    "type": "string",
                                    "description": "AI analysis; required, must not be blank"
                                },
                                "tags": {
                                    "type": [
                                        "null",
                                        "array"
                                    ],
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Optional tags; trimmed, no blanks, no duplicates. Omit or pass an empty array for none."
                                }
                            },
                            "required": [
                                "raw_content",
                                "objective_context",
                                "ai_analysis"
                            ],
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "records_query",
                        "description": "Search mdk's records by optional text phrases (q), tags (tag), and created_at range (from inclusive, to exclusive). Returns a page of matches. page defaults to 1; page_size defaults to 100 and must be 1–1000. At most 10 q values and 10 tags; empty q strings are rejected. Do not use this to create a record, fetch one by id, or as a health check.",
                        "inputSchema": {
                            "type": "object",
                            "properties": {
                                "q": {
                                    "type": ["null", "array"],
                                    "items": {"type": "string"},
                                    "description": "Optional search phrases; each matches raw_content, objective_context, ai_analysis, or tags (ILIKE). At most 10; an empty string is rejected. Omit for no text filter."
                                },
                                "tag": {
                                    "type": ["null", "array"],
                                    "items": {"type": "string"},
                                    "description": "Optional tags; all must be present (AND). At most 10; trimmed, no blanks, no duplicates. Omit for no tag filter."
                                },
                                "from": {
                                    "type": ["null", "string"],
                                    "description": "Optional inclusive lower bound on created_at. RFC 3339 or DateOnly (YYYY-MM-DD, Asia/Shanghai)."
                                },
                                "to": {
                                    "type": ["null", "string"],
                                    "description": "Optional exclusive upper bound on created_at. RFC 3339 or DateOnly (YYYY-MM-DD, Asia/Shanghai)."
                                },
                                "page": {
                                    "type": ["null", "integer"],
                                    "description": "Optional page number, default 1, must be greater than 0."
                                },
                                "page_size": {
                                    "type": ["null", "integer"],
                                    "description": "Optional page size, default 100, must be between 1 and 1000."
                                }
                            },
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "records_tags_attach",
                        "description": "Attach one tag to one of mdk's records. record_id and tag are required; tag is trimmed and must not be blank. Returns the record's tags after the attach. A new tag is status 201 and changed true; repeating the same tag is 200 and changed false. Do not use this to create a record, fetch a record by id, or list every tag in the library.",
                        "inputSchema": {
                            "type": "object",
                            "properties": {
                                "record_id": {
                                    "type": "integer",
                                    "description": "Record ID assigned by the server when the record was created"
                                },
                                "tag": {
                                    "type": "string",
                                    "description": "Tag to attach; trimmed, must not be blank"
                                }
                            },
                            "required": ["record_id", "tag"],
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "records_tags_detach",
                        "description": "Detach one tag from one of mdk's records. record_id and tag are required; tag is trimmed and must not be blank. Returns the record's tags after the detach. Removing a present tag is detached true and changed true; repeating when it is already gone is detached false and changed false. Status is always 200 on success. Do not use this to attach a tag, create a record, or list every tag in the library.",
                        "inputSchema": {
                            "type": "object",
                            "properties": {
                                "record_id": {
                                    "type": "integer",
                                    "description": "Record ID assigned by the server when the record was created"
                                },
                                "tag": {
                                    "type": "string",
                                    "description": "Tag to detach; trimmed, must not be blank"
                                }
                            },
                            "required": ["record_id", "tag"],
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "records_tags_get",
                        "description": "Fetch the tags on one of mdk's records by id. Returns tags as a string array; empty if the record has none. record_id is required. Do not use this to list every tag in the library, search records, or as a health check.",
                        "inputSchema": {
                            "type": "object",
                            "properties": {
                                "record_id": {
                                    "type": "integer",
                                    "description": "Record ID assigned by the server when the record was created"
                                }
                            },
                            "required": ["record_id"],
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "records_tags_get_all",
                        "description": "List every tag that appears in mdk's records, with how many records carry each tag. Returns tag_counts sorted by count descending then tag ascending. No arguments. Unused tags are omitted; if none exist, tag_counts is []. Do not use this to search records, fetch a record by id, or as a health check.",
                        "inputSchema": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "time",
                        "description": "Read the server's current local time (Asia/Shanghai, +08:00). Returns an RFC 3339 timestamp with milliseconds, the time zone, and the date, clock time, and weekday in Chinese. Use this when you need the current time as context; do not use it as a health check or to read or write records.",
                        "inputSchema": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    }
                ]
            }
        }
    },
    "unknown_tool": {
