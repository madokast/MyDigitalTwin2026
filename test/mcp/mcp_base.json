{
    "miss_token": {
        "api": "/mcp",
        "method": "POST",
        "headers": {},
        "data": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "protocolVersion": "2025-06-18",
                "capabilities": {},
                "clientInfo": {"name": "test-client", "version": "1.0.0"}
            }
        },
        "expected": {"ok": false, "status": 401, "message": "missing authorization header"}
    },
    "invalid_token": {
        "api": "/mcp",
        "method": "POST",
        "headers": {"Authorization": "Bearer YOUR_TOKEN_HERE"},
        "data": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "protocolVersion": "2025-06-18",
                "capabilities": {},
                "clientInfo": {"name": "test-client", "version": "1.0.0"}
            }
        },
        "expected": {"ok": false, "status": 401, "message": "invalid token YOUR_TOKEN_HERE"}
    },
    "initialize": {
        "api": "/mcp",
        "method": "POST",
        "headers": {
            "Authorization": "{token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
        },
        "data": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "protocolVersion": "2025-06-18",
                "capabilities": {},
                "clientInfo": {"name": "test-client", "version": "1.0.0"}
            }
        },
        "expected": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
                "protocolVersion": "2025-06-18",
                "capabilities": {
                    "tools": {"listChanged": true}
                },
                "instructions": "{existed}",
                "serverInfo": {
                    "name": "MyDigitalTwin2026",
                    "title": "mdk's personal digital twin",
                    "description": "{existed}",
                    "version": "0.0.1"
                }
            }
        }
    },
    "ping": {
        "api": "/mcp",
        "method": "POST",
        "headers": {
            "Authorization": "{token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
        },
        "data": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "ping",
            "params": {}
        },
        "expected": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {}
        }
    },
    "tools_list": {
        "api": "/mcp",
        "method": "POST",
        "headers": {
            "Authorization": "{token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
        },
        "data": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/list",
            "params": {}
        },
        "expected": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
                "tools": [
                    {
                        "name": "probe_health",
                        "description": "Probe whether the service is up. Returns ok, the HTTP status, and the current server time (milliseconds, +08:00). Do not use this to query history or write records.",
                        "inputSchema": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    },
                    {
                        "name": "time",
                        "description": "Read the server's current local time (Asia/Shanghai, +08:00). Returns an RFC 3339 timestamp with milliseconds, the time zone, and the date, clock time, and weekday in Chinese. Use this when you need the current time as context; do not use it as a health check or to read or write records.",
                        "inputSchema": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "outputSchema": "{existed}"
                    }
                ]
            }
        }
    },
    "unknown_tool": {
        "api": "/mcp",
        "method": "POST",
        "headers": {
            "Authorization": "{token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
        },
        "data": {
            "jsonrpc": "2.0",
            "id": 4,
            "method": "tools/call",
            "params": {"name": "no_such_tool", "arguments": {}}
        },
        "expected": {
            "jsonrpc": "2.0",
            "id": 4,
            "error": {
                "code": -32602,
                "message": "unknown tool \"no_such_tool\""
            }
        }
    }
}
