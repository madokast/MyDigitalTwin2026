{
    "call_ok": {
        "before": [{
            "api": "/api/records",
            "method": "POST",
            "headers": {"Authorization": "{token}"},
            "data": {
                "raw_content": "{unique:1}",
                "objective_context": "{unique:2}",
                "ai_analysis": "{unique:3}",
                "tags": ["{unique:4}"]
            },
            "extractions": ["record.id"]
        }],
        "api": "/mcp",
        "method": "POST",
        "headers": {
            "Authorization": "{token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
        },
        "data": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {
                "name": "records_tags_detach",
                "arguments": {
                    "record_id": "{extracted:record.id}",
                    "tag": "{unique:4}"
                }
            }
        },
        "expected": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
                "content": [
                    {"type": "text", "text": "{existed}"}
                ],
                "structuredContent": {
                    "ok": true,
                    "status": 200,
                    "detached": true,
                    "changed": true,
                    "tags": []
                }
            }
        }
    },
