        },
        "data": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {
                "name": "records_tags_get",
                "arguments": {"record_id": "{extracted:record.id}"}
            }
        },
        "expected": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
                "content": [
                    {"type": "text", "text": "{existed}"}
