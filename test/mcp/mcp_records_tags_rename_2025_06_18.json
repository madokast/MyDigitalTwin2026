{
    "call_ok": {
        "before": [{
            "api": "/api/records",
            "method": "POST",
            "headers": {"Authorization": "{token}"},
            "data": {
                "raw_content": "{unique:1}",
                "objective_context": "{unique:2}",
                "ai_analysis": "{unique:3}",
                "tags": ["{unique:4}"]
            },
            "extractions": ["record.id"]
        }],
        "api": "/mcp",
        "method": "POST",
        "headers": {
            "Authorization": "{token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
        },
        "data": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {
                "name": "records_tags_rename",
                "arguments": {
                    "record_id": "{extracted:record.id}",
                    "tag": "{unique:4}",
                    "new_tag": "{unique:5}"
                }
            }
        },
        "expected": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
                "content": [
                    {"type": "text", "text": "{existed}"}
                ],
                "structuredContent": {
                    "ok": true,
                    "status": 200,
                    "renamed": true,
                    "changed": true,
                    "tags": ["{unique:5}"]
                }
            }
        }
    },
    "idempotent": {
        "before": [
            {
                "api": "/api/records",
                "method": "POST",
                "headers": {"Authorization": "{token}"},
                "data": {
                    "raw_content": "{unique:1}",
                    "objective_context": "{unique:2}",
                    "ai_analysis": "{unique:3}",
                    "tags": ["{unique:4}"]
                },
                "extractions": ["record.id"]
            },
            {
                "api": "/api/records/{extracted:record.id}/tags/{unique:4}",
                "method": "PATCH",
                "headers": {"Authorization": "{token}"},
                "data": {"new_tag": "{unique:5}"}
            }
        ],
        "api": "/mcp",
        "method": "POST",
        "headers": {
            "Authorization": "{token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
        },
        "data": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/call",
            "params": {
                "name": "records_tags_rename",
                "arguments": {
                    "record_id": "{extracted:record.id}",
                    "tag": "{unique:4}",
                    "new_tag": "{unique:6}"
                }
            }
        },
        "expected": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
                "content": [
                    {"type": "text", "text": "{existed}"}
                ],
                "structuredContent": {
                    "ok": true,
                    "status": 200,
                    "renamed": false,
                    "changed": false,
                    "tags": ["{unique:5}"]
                }
            }
        }
    },
