{
    "from_inclusive":{
        "before": [{
            "api": "/api/records",
            "method": "POST",
            "headers": {"Authorization": "{token}"},
            "data": {"raw_content": "{unique:1}","objective_context": "{unique:2}","ai_analysis": "{unique:3}",
                "tags": ["{unique:4}"]},
            "extractions": ["record.created_at"]
        }],
        "api": "/api/records?page_size=10&q={unique:1}&from={extracted:record.created_at}",
        "method": "GET",
        "headers": {"Authorization": "{token}"},
        "expected": {"ok":true,"status":200,"page":1,"page_size":10,"total":1,"total_page":1,"records":[
            {"id":"{existed}","created_at":"{extracted:record.created_at}","raw_content":"{unique:1}","objective_context":"{existed}","ai_analysis":"{existed}","tags":["{unique:4}"]}
        ]}
    },
    "from_after_record":{
        "before": [{
            "api": "/api/records",
            "method": "POST",
            "headers": {"Authorization": "{token}"},
            "data": {"raw_content": "{unique:1}","objective_context": "{unique:2}","ai_analysis": "{unique:3}"}
        }],
        "api": "/api/records?page_size=10&q={unique:1}&from=2030-01-01T00:00:00Z",
        "method": "GET",
        "headers": {"Authorization": "{token}"},
        "expected": {"ok":true,"status":200,"page":1,"page_size":10,"total":0,"total_page":0,"records":"{array:0}"}
    },
