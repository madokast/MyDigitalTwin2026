    "from_invalid":{
        "api": "/api/records?page_size=10&from=notatime",
        "method": "GET",
        "headers": {"Authorization": "{token}"},
        "expected": {"ok":false,"status":400,"message":"invalid time value notatime: parsing time \"notatime\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"notatime\" as \"2006\""}
    },
    "from_date_only":{
        "api": "/api/records?page_size=10&from=2026-08-08",
